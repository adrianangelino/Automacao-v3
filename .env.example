# Copie para .env e ajuste. O .env fica fora do git.

PORT=3999

# Banco local (quem já foi abordado e quando) e perfil do Chrome (login salvo)
BOT_DB_PATH=data/bot.sqlite
BOT_CHROME_PROFILE=data/chrome-profile

# Limites de abordagem — o bloqueio de busca de 21/10 veio de 64 + 29 abordagens sem teto
BOT_LIMIT_PER_DAY=20
BOT_LIMIT_PER_HOUR=6

# Ritmo humano: multiplica todas as pausas (1 = normal, 1.5 = mais calmo)
BOT_PACE=1

# Termos de busca por rodada e lista de termos (separados por |)
BOT_TERMS_PER_RUN=2
# BOT_SEARCH_TERMS=hiring backend engineer remote LATAM|hiring software engineer relocation

BOT_YEARS_OF_EXPERIENCE=5

# Rodadas automáticas: a cada ~N min (±25%), só no horário, no máximo M abordagens por rodada.
# BOT_AUTO_LIVE=false roda em dry-run (não convida nem manda msg).
BOT_AUTO_RUN=false
BOT_AUTO_EVERY_MIN=90
BOT_AUTO_HOURS=9-19
BOT_AUTO_MAX_PER_RUN=4
BOT_AUTO_LIVE=false

# Docker: senha da tela do Chrome no navegador (http://localhost:6080/vnc.html). Vazio = sem senha.
VNC_PASSWORD=
